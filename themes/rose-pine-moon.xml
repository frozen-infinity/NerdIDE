<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rose-pine-moon" _name="Rosé Pine Moon" version="1.0">
  <author>OpenAI</author>
  <_description>Rosé Pine Moon for GtkSourceView</_description>

  <style name="text"                foreground="#e0def4" background="#232136"/>
  <style name="selection"           background="#44415a"/>
  <style name="cursor-line"         background="#2a283e"/>
  <style name="current-line"        background="#2a283e"/>
  <style name="line-numbers"        foreground="#6e6a86" background="#2a273f"/>
  <style name="bracket-match"       foreground="#232136" background="#c4a7e7" bold="true"/>
  <style name="search-match"        foreground="#232136" background="#9ccfd8" bold="true"/>

  <style name="comment"             foreground="#6e6a86" italic="true"/>
  <style name="def:comment"         use-style="comment"/>

  <style name="string"              foreground="#f6c177"/>
  <style name="def:string"          use-style="string"/>
  <style name="def:character"       use-style="string"/>
  <style name="def:special-char"    foreground="#eb6f92"/>

  <style name="keyword"             foreground="#c4a7e7" bold="true"/>
  <style name="def:keyword"         use-style="keyword"/>
  <style name="def:statement"       use-style="keyword"/>

  <style name="number"              foreground="#ea9a97"/>
  <style name="def:number"          use-style="number"/>
  <style name="def:floating-point"  use-style="number"/>

  <style name="function"            foreground="#9ccfd8"/>
  <style name="def:function"        use-style="function"/>

  <style name="type"                foreground="#3e8fb0"/>
  <style name="def:type"            use-style="type"/>

  <style name="constant"            foreground="#eb6f92"/>
  <style name="def:constant"        use-style="constant"/>
  <style name="def:boolean"         use-style="constant"/>

  <style name="operator"            foreground="#908caa"/>
  <style name="def:operator"        use-style="operator"/>

  <style name="preprocessor"        foreground="#3e8fb0"/>
  <style name="def:preprocessor"    use-style="preprocessor"/>

  <style name="error"               foreground="#eb6f92" underline="error"/>
  <style name="warning"             foreground="#f6c177" underline="single"/>
</style-scheme>
