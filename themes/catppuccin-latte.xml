<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="catppuccin-latte" _name="Catppuccin Latte" version="1.0">
  <author>OpenAI</author>
  <_description>Catppuccin Latte for GtkSourceView</_description>

  <style name="text"                foreground="#4c4f69" background="#eff1f5"/>
  <style name="selection"           background="#acb0be"/>
  <style name="cursor-line"         background="#ccd0da"/>
  <style name="current-line"        background="#ccd0da"/>
  <style name="line-numbers"        foreground="#9ca0b0" background="#e6e9ef"/>
  <style name="bracket-match"       foreground="#eff1f5" background="#7287fd" bold="true"/>
  <style name="search-match"        foreground="#eff1f5" background="#179299" bold="true"/>

  <style name="comment"             foreground="#8c8fa1" italic="true"/>
  <style name="def:comment"         use-style="comment"/>

  <style name="string"              foreground="#40a02b"/>
  <style name="def:string"          use-style="string"/>
  <style name="def:character"       use-style="string"/>
  <style name="def:special-char"    foreground="#ea76cb"/>

  <style name="keyword"             foreground="#8839ef" bold="true"/>
  <style name="def:keyword"         use-style="keyword"/>
  <style name="def:statement"       use-style="keyword"/>

  <style name="number"              foreground="#fe640b"/>
  <style name="def:number"          use-style="number"/>
  <style name="def:floating-point"  use-style="number"/>

  <style name="function"            foreground="#1e66f5"/>
  <style name="def:function"        use-style="function"/>

  <style name="type"                foreground="#df8e1d"/>
  <style name="def:type"            use-style="type"/>

  <style name="constant"            foreground="#ea76cb"/>
  <style name="def:constant"        use-style="constant"/>
  <style name="def:boolean"         use-style="constant"/>

  <style name="operator"            foreground="#04a5e5"/>
  <style name="def:operator"        use-style="operator"/>

  <style name="preprocessor"        foreground="#d20f39"/>
  <style name="def:preprocessor"    use-style="preprocessor"/>

  <style name="error"               foreground="#d20f39" underline="error"/>
  <style name="warning"             foreground="#df8e1d" underline="single"/>
</style-scheme>
