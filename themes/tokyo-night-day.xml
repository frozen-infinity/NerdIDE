<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="tokyo-night-day" _name="Tokyo Night Day" version="1.0">
  <author>OpenAI</author>
  <_description>Tokyo Night Day for GtkSourceView</_description>

  <style name="text"                foreground="#3760bf" background="#e1e2e7"/>
  <style name="selection"           background="#c4c8da"/>
  <style name="cursor-line"         background="#c4c8da"/>
  <style name="current-line"        background="#c4c8da"/>
  <style name="line-numbers"        foreground="#848cb5" background="#d5d6db"/>
  <style name="bracket-match"       foreground="#e1e2e7" background="#2e7de9" bold="true"/>
  <style name="search-match"        foreground="#e1e2e7" background="#007197" bold="true"/>

  <style name="comment"             foreground="#848cb5" italic="true"/>
  <style name="def:comment"         use-style="comment"/>

  <style name="string"              foreground="#587539"/>
  <style name="def:string"          use-style="string"/>
  <style name="def:character"       use-style="string"/>
  <style name="def:special-char"    foreground="#9854f1"/>

  <style name="keyword"             foreground="#7847bd" bold="true"/>
  <style name="def:keyword"         use-style="keyword"/>
  <style name="def:statement"       use-style="keyword"/>

  <style name="number"              foreground="#b15c00"/>
  <style name="def:number"          use-style="number"/>
  <style name="def:floating-point"  use-style="number"/>

  <style name="function"            foreground="#2e7de9"/>
  <style name="def:function"        use-style="function"/>

  <style name="type"                foreground="#8c6c3e"/>
  <style name="def:type"            use-style="type"/>

  <style name="constant"            foreground="#9854f1"/>
  <style name="def:constant"        use-style="constant"/>
  <style name="def:boolean"         use-style="constant"/>

  <style name="operator"            foreground="#007197"/>
  <style name="def:operator"        use-style="operator"/>

  <style name="preprocessor"        foreground="#f52a65"/>
  <style name="def:preprocessor"    use-style="preprocessor"/>

  <style name="error"               foreground="#f52a65" underline="error"/>
  <style name="warning"             foreground="#8c6c3e" underline="single"/>
</style-scheme>
