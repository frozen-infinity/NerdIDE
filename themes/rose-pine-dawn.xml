<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rose-pine-dawn" _name="Rosé Pine Dawn" version="1.0">
  <author>OpenAI</author>
  <_description>Rosé Pine Dawn for GtkSourceView</_description>

  <style name="text"                foreground="#575279" background="#faf4ed"/>
  <style name="selection"           background="#dfdad9"/>
  <style name="cursor-line"         background="#f4ede8"/>
  <style name="current-line"        background="#f4ede8"/>
  <style name="line-numbers"        foreground="#9893a5" background="#fffaf3"/>
  <style name="bracket-match"       foreground="#faf4ed" background="#907aa9" bold="true"/>
  <style name="search-match"        foreground="#faf4ed" background="#56949f" bold="true"/>

  <style name="comment"             foreground="#9893a5" italic="true"/>
  <style name="def:comment"         use-style="comment"/>

  <style name="string"              foreground="#ea9d34"/>
  <style name="def:string"          use-style="string"/>
  <style name="def:character"       use-style="string"/>
  <style name="def:special-char"    foreground="#b4637a"/>

  <style name="keyword"             foreground="#907aa9" bold="true"/>
  <style name="def:keyword"         use-style="keyword"/>
  <style name="def:statement"       use-style="keyword"/>

  <style name="number"              foreground="#d7827e"/>
  <style name="def:number"          use-style="number"/>
  <style name="def:floating-point"  use-style="number"/>

  <style name="function"            foreground="#56949f"/>
  <style name="def:function"        use-style="function"/>

  <style name="type"                foreground="#286983"/>
  <style name="def:type"            use-style="type"/>

  <style name="constant"            foreground="#b4637a"/>
  <style name="def:constant"        use-style="constant"/>
  <style name="def:boolean"         use-style="constant"/>

  <style name="operator"            foreground="#797593"/>
  <style name="def:operator"        use-style="operator"/>

  <style name="preprocessor"        foreground="#286983"/>
  <style name="def:preprocessor"    use-style="preprocessor"/>

  <style name="error"               foreground="#b4637a" underline="error"/>
  <style name="warning"             foreground="#ea9d34" underline="single"/>
</style-scheme>
