<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="nordic" _name="Nordic" version="1.0">
  <author>OpenAI</author>
  <_description>Nordic for GtkSourceView</_description>

  <style name="text"                foreground="#d8dee9" background="#2e3440"/>
  <style name="selection"           background="#4c566a"/>
  <style name="cursor-line"         background="#3b4252"/>
  <style name="current-line"        background="#3b4252"/>
  <style name="line-numbers"        foreground="#4c566a" background="#3b4252"/>
  <style name="bracket-match"       foreground="#2e3440" background="#b48ead" bold="true"/>
  <style name="search-match"        foreground="#2e3440" background="#8fbcbb" bold="true"/>

  <style name="comment"             foreground="#4c566a" italic="true"/>
  <style name="def:comment"         use-style="comment"/>

  <style name="string"              foreground="#a3be8c"/>
  <style name="def:string"          use-style="string"/>
  <style name="def:character"       use-style="string"/>
  <style name="def:special-char"    foreground="#ebcb8b"/>

  <style name="keyword"             foreground="#b48ead" bold="true"/>
  <style name="def:keyword"         use-style="keyword"/>
  <style name="def:statement"       use-style="keyword"/>

  <style name="number"              foreground="#d08770"/>
  <style name="def:number"          use-style="number"/>
  <style name="def:floating-point"  use-style="number"/>

  <style name="function"            foreground="#81a1c1"/>
  <style name="def:function"        use-style="function"/>

  <style name="type"                foreground="#8fbcbb"/>
  <style name="def:type"            use-style="type"/>

  <style name="constant"            foreground="#ebcb8b"/>
  <style name="def:constant"        use-style="constant"/>
  <style name="def:boolean"         use-style="constant"/>

  <style name="operator"            foreground="#e5e9f0"/>
  <style name="def:operator"        use-style="operator"/>

  <style name="preprocessor"        foreground="#bf616a"/>
  <style name="def:preprocessor"    use-style="preprocessor"/>

  <style name="error"               foreground="#bf616a" underline="error"/>
  <style name="warning"             foreground="#ebcb8b" underline="single"/>
</style-scheme>
