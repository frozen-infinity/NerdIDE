<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="catppuccin-mocha" _name="Catppuccin Mocha" version="1.0">
  <author>OpenAI</author>
  <_description>Catppuccin Mocha for GtkSourceView</_description>

  <style name="text"                foreground="#cdd6f4" background="#1e1e2e"/>
  <style name="selection"           background="#585b70"/>
  <style name="cursor-line"         background="#313244"/>
  <style name="current-line"        background="#313244"/>
  <style name="line-numbers"        foreground="#6c7086" background="#181825"/>
  <style name="bracket-match"       foreground="#1e1e2e" background="#b4befe" bold="true"/>
  <style name="search-match"        foreground="#1e1e2e" background="#94e2d5" bold="true"/>

  <style name="comment"             foreground="#7f849c" italic="true"/>
  <style name="def:comment"         use-style="comment"/>

  <style name="string"              foreground="#a6e3a1"/>
  <style name="def:string"          use-style="string"/>
  <style name="def:character"       use-style="string"/>
  <style name="def:special-char"    foreground="#f5c2e7"/>

  <style name="keyword"             foreground="#cba6f7" bold="true"/>
  <style name="def:keyword"         use-style="keyword"/>
  <style name="def:statement"       use-style="keyword"/>

  <style name="number"              foreground="#fab387"/>
  <style name="def:number"          use-style="number"/>
  <style name="def:floating-point"  use-style="number"/>

  <style name="function"            foreground="#89b4fa"/>
  <style name="def:function"        use-style="function"/>

  <style name="type"                foreground="#f9e2af"/>
  <style name="def:type"            use-style="type"/>

  <style name="constant"            foreground="#f5c2e7"/>
  <style name="def:constant"        use-style="constant"/>
  <style name="def:boolean"         use-style="constant"/>

  <style name="operator"            foreground="#89dceb"/>
  <style name="def:operator"        use-style="operator"/>

  <style name="preprocessor"        foreground="#f38ba8"/>
  <style name="def:preprocessor"    use-style="preprocessor"/>

  <style name="error"               foreground="#f38ba8" underline="error"/>
  <style name="warning"             foreground="#f9e2af" underline="single"/>
</style-scheme>
